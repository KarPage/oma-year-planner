#!/bin/sh
# Serve the planner so the service worker can register.
# Opening index.html as a file cannot install the offline app.
cd "$(dirname "$0")" || exit 1
ROOT=$(pwd)
if ! curl -sf -o /dev/null --max-time 0.4 http://127.0.0.1:47321/status; then
  setsid "$ROOT/bridge" >/dev/null 2>&1 < /dev/null &
fi
exec python3 -m http.server 8080

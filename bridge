#!/usr/bin/env python3
"""Localhost-only bridge so the planner page can pin the wallpaper.

A file:// page cannot run shell commands. ./open starts this on 127.0.0.1.
It accepts only pin, unpin, toggle (POST) and status, ping (GET), and it
never reads a request body. `./bridge ensure` starts it if needed and prints
the token.

Every request must carry the secret token in the X-Planner-Token header.
The token is 32 random bytes kept in a mode 0600 file under $XDG_RUNTIME_DIR,
so only this user can read it, and it is gone at logout. ./open hands it to
the page in the URL fragment. The Origin and Host checks below are kept as a
second layer, but neither is ever enough on its own: Origin null is shared by
every local file and sandboxed document.
"""
import hmac
import json
import os
import secrets
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT = os.path.dirname(os.path.abspath(__file__))
WALL = os.environ.get("OMA_YEAR_WALLPAPER") or os.path.join(ROOT, "wallpaper")
HOST = "127.0.0.1"
PORT = int(os.environ.get("OMA_YEAR_BRIDGE_PORT") or 47321)
ALLOWED = {"null", "http://localhost:8080", "http://127.0.0.1:8080"}
HOSTS = {"127.0.0.1:%d" % PORT, "localhost:%d" % PORT}
TOKEN_HEADER = "X-Planner-Token"


def token_path():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base or not os.path.isdir(base):
        base = os.path.join(os.path.expanduser("~"), ".cache")
    return os.path.join(base, "oma-year-planner", "bridge-token")


def load_or_create_token():
    """Reuse this login's token if it is ours and private, else make a new one.

    Reuse keeps an open planner window working when the helper is restarted.
    """
    path = token_path()
    folder = os.path.dirname(path)
    os.makedirs(folder, mode=0o700, exist_ok=True)
    os.chmod(folder, 0o700)
    try:
        st = os.stat(path)
        if st.st_uid == os.getuid() and (st.st_mode & 0o077) == 0:
            with open(path, "r", encoding="ascii") as fh:
                token = fh.read().strip()
            if len(token) == 64 and all(c in "0123456789abcdef" for c in token):
                return token
    except (OSError, ValueError):
        pass
    token = secrets.token_hex(32)
    tmp = path + ".%d" % os.getpid()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="ascii") as fh:
        fh.write(token + "\n")
    os.replace(tmp, path)
    return token


TOKEN = ""


def pinned_now():
    result = subprocess.run([WALL, "status"], capture_output=True, text=True, timeout=30)
    first = (result.stdout or "").splitlines()
    line = first[0].strip() if first else ""
    return line == "pinned", result.returncode


class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def forbid(self, origin=None):
        body = json.dumps({"error": "forbidden"}).encode()
        self.send_response(403)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        if origin:
            # Let the planner page read the 403 so it can show a hint.
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def gate(self, need_token=True):
        """Return the allowed Origin, or send 403 and return None."""
        if self.client_address[0] not in ("127.0.0.1", "::1"):
            self.forbid()
            return None
        # A rebinding DNS name resolving to 127.0.0.1 still sends its own Host.
        if (self.headers.get("Host") or "").lower() not in HOSTS:
            self.forbid()
            return None
        origin = self.headers.get("Origin")
        if origin not in ALLOWED:
            self.forbid()
            return None
        if need_token:
            sent = self.headers.get(TOKEN_HEADER) or ""
            if not TOKEN or not hmac.compare_digest(sent.encode(), TOKEN.encode()):
                self.forbid(origin)
                return None
        return origin

    def send_json(self, code, payload, origin):
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Vary", "Origin")
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        # Preflights never carry custom headers, so they cannot be token checked.
        # They only say which request the real call may make; it runs nothing.
        origin = self.gate(need_token=False)
        if not origin:
            return
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", origin)
        self.send_header("Access-Control-Allow-Methods", "GET, POST")
        self.send_header("Access-Control-Allow-Headers", TOKEN_HEADER)
        self.send_header("Access-Control-Max-Age", "600")
        self.send_header("Vary", "Origin")
        self.send_header("Content-Length", "0")
        self.end_headers()

    def do_GET(self):
        origin = self.gate()
        if not origin:
            return
        route = self.path.split("?", 1)[0]
        if route == "/ping":
            self.send_json(200, {"ok": True}, origin)
            return
        if route != "/status":
            self.send_json(404, {"error": "not found"}, origin)
            return
        pinned, code = pinned_now()
        self.send_json(200 if code == 0 else 500, {"pinned": pinned}, origin)

    def do_POST(self):
        origin = self.gate()
        if not origin:
            return
        action = self.path.split("?", 1)[0].lstrip("/")
        if action not in ("pin", "unpin", "toggle"):
            self.send_json(404, {"error": "not found"}, origin)
            return
        # Discard any body. The action comes only from the path.
        length = int(self.headers.get("Content-Length") or 0)
        if length:
            self.rfile.read(min(length, 4096))
        result = subprocess.run([WALL, action], capture_output=True, text=True, timeout=180)
        pinned, _code = pinned_now()
        if result.returncode != 0:
            self.send_json(500, {"pinned": pinned, "error": "failed"}, origin)
            return
        self.send_json(200, {"pinned": pinned}, origin)

    def do_PUT(self):
        self.forbid()

    do_DELETE = do_PATCH = do_HEAD = do_PUT


def read_token():
    try:
        with open(token_path(), "r", encoding="ascii") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def healthy(token):
    if not token:
        return False
    import urllib.request
    req = urllib.request.Request(
        "http://127.0.0.1:%d/ping" % PORT,
        headers={"Origin": "null", TOKEN_HEADER: token},
    )
    try:
        with urllib.request.urlopen(req, timeout=0.4) as res:
            return res.status == 200
    except Exception:
        return False


def ensure():
    """Start the helper if needed, then print its token for ./open.

    The token goes to stdout only, never onto a command line.
    """
    import time
    token = read_token()
    if not healthy(token):
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__)],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True,
        )
        for _ in range(30):
            time.sleep(0.1)
            token = read_token()
            if healthy(token):
                break
        else:
            return 1
    sys.stdout.write(token + "\n")
    return 0


def main():
    global TOKEN
    if sys.argv[1:] == ["ensure"]:
        return ensure()
    try:
        server = ThreadingHTTPServer((HOST, PORT), Handler)
    except OSError:
        # Already running.
        return 0
    TOKEN = load_or_create_token()
    server.serve_forever()
    return 0


if __name__ == "__main__":
    sys.exit(main())

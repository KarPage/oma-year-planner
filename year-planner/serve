#!/bin/sh
# Serve the planner so the service worker can register.
# Opening index.html as a file cannot install the offline app.
cd "$(dirname "$0")" || exit 1
ROOT=$(pwd)
# The token is never printed. Opening the private launcher page hands it to
# that tab; the page is deleted after ten minutes.
if LAUNCHER=$("$ROOT/bridge" launch served 2>/dev/null) && [ -n "$LAUNCHER" ]; then
  echo "To use Pin to desktop, open file://$LAUNCHER in Chromium (one tab, within 10 minutes)."
fi
echo "Planner: http://localhost:8080"
exec python3 -m http.server 8080 --bind 127.0.0.1

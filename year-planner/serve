#!/bin/sh
# Serve the planner so the service worker can register.
# Opening index.html as a file cannot install the offline app.
cd "$(dirname "$0")" || exit 1
ROOT=$(pwd)
if TOKEN=$("$ROOT/bridge" ensure 2>/dev/null); then
  # Open this link once; the page keeps the token for that tab.
  echo "Open http://localhost:8080/#bt=$TOKEN to use Pin to desktop."
fi
exec python3 -m http.server 8080
